# PostgreSQL (match docker-compose or your local instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/company_registry

# LLM — set at least one provider
# OpenAI (preferred when OPENAI_API_KEY is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (or use GOOGLE_API_KEY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: force openai | gemini (otherwise OpenAI is used if OPENAI_API_KEY is set)
# LLM_PROVIDER=openai

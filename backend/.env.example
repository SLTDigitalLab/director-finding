# PostgreSQL (match docker-compose or your local instance)
DATABASE_URL=postgresql://postgres:password@localhost:5432/director_finding

# --- PDF extraction: use OpenAI OR Gemini (not both) ---
# Uncomment ONE provider block and comment out the other, then restart uvicorn.
#
# OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
#
# Gemini (or use GOOGLE_API_KEY instead of GEMINI_API_KEY):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
#
# If both keys are uncommented, OpenAI is used unless you set:
# LLM_PROVIDER=gemini

# Azure AD (backend token validation)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
